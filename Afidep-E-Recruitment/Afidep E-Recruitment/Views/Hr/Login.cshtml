@{
    ViewBag.Title = "HR sign in";
    Layout = "~/Views/Shared/_HrLayout.cshtml";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card p-4">
            <h4 class="mb-1">HR sign in</h4>
            <p class="text-muted small mb-4">Longlisting and shortlisting of job applicants</p>
            @using (Html.BeginForm("Login", "Hr", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label" for="username">Username</label>
                    <input class="form-control" id="username" name="username" autocomplete="username" required autofocus />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required />
                </div>
                <button class="btn btn-enaf w-100" type="submit">Sign in</button>
            }
        </div>
    </div>
</div>
