@model Afidep_E_Recruitment.Controllers.HrController.JobPage
@using Afidep_E_Recruitment.Models.Screening
@{
    ViewBag.Title = Model.Job.jobdescription;
    Layout = "~/Views/Shared/_HrLayout.cshtml";
    var c = Model.Criteria;
    var run = Model.Run;
    var open = Model.Job.closingdate.Date >= DateTime.Today;
}
<a href="@Url.Action("Index", "Hr")" class="small">&larr; All jobs</a>
<div class="d-flex justify-content-between align-items-start mt-2 mb-3">
    <div>
        <h3 class="mb-0">@Model.Job.jobdescription</h3>
        <div class="text-muted">@Model.Job.requestid · @Model.Job.contracttype · closes @Model.Job.closingdate.ToString("d MMM yyyy")
            · <strong>@Model.Job.submitted</strong> submitted, @Model.Job.drafts draft@(Model.Job.drafts == 1 ? "" : "s") (drafts are not screened)</div>
    </div>
</div>
@if (open)
{
    <div class="alert alert-warning py-2">Applications are still open until @Model.Job.closingdate.ToString("d MMM yyyy"). You can screen now, but run it again after closing so late applicants are included.</div>
}

<div class="row g-4">
    <!-- criteria -->
    <div class="col-xl-4">
        <div class="card p-3">
            <h5>Screening criteria</h5>
            <p class="text-muted small">
                @if (Model.CriteriaFromAdvert) { <span>Taken from the job advert – check and save.</span> }
                else { <span>Saved @(Model.CriteriaSavedAt?.ToString("d MMM yyyy HH:mm")) by @Model.CriteriaSavedBy.</span> }
            </p>
            @using (Html.BeginForm("SaveCriteria", "Hr", new { id = Model.Job.requestid }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <h6 class="mt-2">Must-haves (longlisting)</h6>
                <div class="mb-2">
                    <label class="form-label small mb-0" for="minEducationLevel">Minimum education</label>
                    <select class="form-select form-select-sm" id="minEducationLevel" name="minEducationLevel">
                        <option value="">No minimum</option>
                        @foreach (var l in ScreeningEngine.EducationLevels)
                        {
                            <option value="@l" @(l == c.MinEducationLevel ? "selected" : "")>@l</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-0" for="minYearsExperience">Minimum years of experience</label>
                    <input class="form-control form-control-sm" id="minYearsExperience" name="minYearsExperience" type="number" min="0" max="50" step="0.5" value="@c.MinYearsExperience.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" />
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-0" for="requiredQualifications">Required qualifications <span class="text-muted">(one per line; alternatives with |, e.g. CPA|ACCA)</span></label>
                    <textarea class="form-control form-control-sm" id="requiredQualifications" name="requiredQualifications" rows="2">@string.Join("\n", c.RequiredQualifications)</textarea>
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-0" for="requiredMemberships">Required memberships <span class="text-muted">(one per line)</span></label>
                    <textarea class="form-control form-control-sm" id="requiredMemberships" name="requiredMemberships" rows="2">@string.Join("\n", c.RequiredMemberships)</textarea>
                </div>
                <div class="mb-2">
                    <div class="form-label small mb-0">Required documents</div>
                    @foreach (var d in ScreeningEngine.DocumentTypes)
                    {
                        var idd = "doc-" + d.Replace(" ", "");
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="@idd" name="requiredDocuments" value="@d" @(c.RequiredDocuments.Contains(d) ? "checked" : "") />
                            <label class="form-check-label small" for="@idd">@d</label>
                        </div>
                    }
                </div>
                <h6 class="mt-3">Scored (shortlisting)</h6>
                <div class="mb-2">
                    <label class="form-label small mb-0" for="desirableQualifications">Desirable qualifications / memberships <span class="text-muted">(one per line)</span></label>
                    <textarea class="form-control form-control-sm" id="desirableQualifications" name="desirableQualifications" rows="2">@string.Join("\n", c.DesirableQualifications)</textarea>
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-0" for="keywords">Job keywords looked for in the documents <span class="text-muted">(one per line)</span></label>
                    <textarea class="form-control form-control-sm" id="keywords" name="keywords" rows="5">@string.Join("\n", c.Keywords)</textarea>
                </div>
                <p class="small text-muted mb-2">Score out of 100: education 20 · experience 30 (relevant years count fully, other years half) · professional qualifications 15 · documents matching the job keywords 35.</p>
                <button class="btn btn-outline-primary btn-sm" type="submit">Save criteria</button>
            }
            @using (Html.BeginForm("ResetCriteria", "Hr", new { id = Model.Job.requestid }, FormMethod.Post, new { @class = "d-inline" }))
            {
                @Html.AntiForgeryToken()
                <button class="btn btn-link btn-sm" type="submit">Reset to the job advert</button>
            }
        </div>
    </div>

    <!-- screening -->
    <div class="col-xl-8">
        <div class="card p-3 mb-3">
            <div class="d-flex flex-wrap gap-3 align-items-end">
                @using (Html.BeginForm("Longlist", "Hr", new { id = Model.Job.requestid }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="small text-muted mb-1">Step 1</div>
                    <button class="btn btn-enaf" type="submit">Run longlisting</button>
                }
                <div class="vr"></div>
                @using (Html.BeginForm("Shortlist", "Hr", new { id = Model.Job.requestid }, FormMethod.Post, new { @class = "d-flex gap-2 align-items-end" }))
                {
                    @Html.AntiForgeryToken()
                    <div>
                        <div class="small text-muted mb-1">Step 2 – shortlist</div>
                        <select class="form-select" name="mode" aria-label="Shortlist by">
                            <option value="Number" @(run?.ShortlistMode == "Percent" ? "" : "selected")>Number of applicants</option>
                            <option value="Percent" @(run?.ShortlistMode == "Percent" ? "selected" : "")>% of the longlist</option>
                        </select>
                    </div>
                    <input class="form-control" style="width:100px" name="value" type="number" min="1" step="any" required aria-label="How many"
                           value="@(run?.ShortlistValue?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "5")" />
                    <button class="btn btn-success" type="submit">Shortlist</button>
                }
                @if (run != null)
                {
                    <a class="btn btn-outline-secondary ms-auto" href="@Url.Action("Export", "Hr", new { id = Model.Job.requestid })">Export (CSV)</a>
                }
            </div>
        </div>

        @if (run == null)
        {
            <div class="text-muted">Not screened yet. Check the criteria, then run the longlisting.</div>
        }
        else
        {
            <div class="mb-2">
                <strong>@run.Considered</strong> screened ·
                <strong>@run.Longlisted</strong> longlisted
                @if (run.Stage == "Shortlist")
                {
                    <span>· <strong class="text-success">@run.Shortlisted shortlisted</strong> (@(run.ShortlistMode == "Percent" ? run.ShortlistValue?.ToString("0.##") + "% of the longlist, rounded up" : "top " + run.ShortlistValue?.ToString("0")))</span>
                }
                <span class="text-muted small">– @run.Stage.ToLower() run @run.RunAt.ToString("d MMM yyyy HH:mm") by @run.RunBy</span>
            </div>
            <div class="card">
                <table class="table mb-0 align-top">
                    <thead class="table-light">
                        <tr><th style="width:60px">Rank</th><th>Applicant</th><th style="width:150px">Score</th><th>Reason</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in run.Results)
                        {
                            var docs = Model.Documents.ContainsKey(r.ApplicationNo) ? Model.Documents[r.ApplicationNo] : new List<ApplicantDocument>();
                            <tr class="@(r.Shortlisted ? "shortlisted" : "")">
                                <td>@(r.Rank?.ToString() ?? "–")</td>
                                <td>
                                    <strong>@r.ApplicantName</strong>
                                    <div class="small text-muted">@r.ApplicationNo · @r.ApplicantId</div>
                                    @if (r.Shortlisted) { <span class="badge bg-success">Shortlisted</span> }
                                    else if (r.Longlisted) { <span class="badge bg-primary">Longlisted</span> }
                                    else { <span class="badge bg-secondary">Not longlisted</span> }
                                    <div class="small mt-1">
                                        @foreach (var d in docs)
                                        {
                                            <a class="me-2" href="@Url.Action("Document", "Hr", new { id = d.Id })" target="_blank">@d.Type</a>
                                        }
                                        <span class="text-muted">(@r.DocumentsRead of @r.DocumentsUploaded read)</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="score">@r.Score.ToString("0.0")<span class="text-muted small">/100</span></div>
                                    <div class="bar mb-1"><span style="width:@(r.Score.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                                    <div class="small text-muted">
                                        Education @r.Breakdown.Education.ToString("0.#")/20<br />
                                        Experience @r.Breakdown.Experience.ToString("0.#")/30<br />
                                        Professional @r.Breakdown.Professional.ToString("0.#")/15<br />
                                        Documents @r.Breakdown.DocumentMatch.ToString("0.#")/35
                                    </div>
                                </td>
                                <td>
                                    <div class="reason">@r.Reason</div>
                                    @if (!string.IsNullOrEmpty(r.TieNote))
                                    {
                                        <div class="tie"><strong>Tie-break:</strong> @r.TieNote</div>
                                    }
                                    <details class="small mt-1">
                                        <summary>Must-haves checked</summary>
                                        <ul class="mb-0 ps-3">
                                            @foreach (var ch in r.Checks)
                                            {
                                                <li class="@(ch.Met ? "check-ok" : "check-no")">@(ch.Met ? "✔" : "✘") @ch.Criterion – @ch.Detail</li>
                                            }
                                        </ul>
                                        @if (r.DocumentProblems.Any())
                                        {
                                            <div class="text-warning mt-1">Not read: @string.Join("; ", r.DocumentProblems)</div>
                                        }
                                    </details>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
