@model Afidep_E_Recruitment.Models.LRClasses.RegistrationUserClass

@{
    ViewBag.Title = "Success";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<section class="loginarea">
    <div class="top-side">
        <img src="~/Content/images/afideplogo.png" alt="AFIDEP" class="topsidemage" />
    </div>
    <div class="loginbox">
        <div class="loginbox-header">
            <h1>Email Verified!</h1>
        </div>

        <div class="checkmark-wrapper">
            <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                <circle class="checkmark__circle" cx="26" cy="26" r="25" fill="none" />
                <path class="checkmark__check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8" />
            </svg>
        </div>

        <div class="loginform">
            <div class="form-group">
                <a href="@Url.Action("SetNewPassword", "Register", new { userid = Model.id_number })" class="loginbutton">Set password</a>
            </div>
        </div>
    </div>
</section>


