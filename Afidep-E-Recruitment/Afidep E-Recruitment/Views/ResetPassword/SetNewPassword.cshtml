@model Afidep_E_Recruitment.Models.LRClasses.RegistrationUserClass

@{
    ViewBag.Title = "Set New Password";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<section class="loginarea">
   
    <div class="loginbox">
        <div class="loginbox-header">
            <h1>Recruitment Portal</h1>
            <h1>Set New Password</h1>
        </div>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-error">
                @TempData["ErrorMessage"]
            </div>
        }

        @using (Html.BeginForm("SetNewPasswordForm", "Register", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.id_number)

            <!-- Username or Email (Readonly) -->
            <div class="form-group">
                <input type="text" id="username" name="username" class="form-input" value="@Model.id_number" readonly />
            </div>

            <!-- New Password -->
            <div class="form-group">
                <input type="password" id="password" name="password" class="form-input" placeholder="New Password" required />
                <span class="inputerror" id="passwordError">Password is required *</span>
                <div class="password-strength-indicator">
                    <div class="strength-bar" id="strengthBar"></div>
                </div>
                <span class="strength-text" id="strengthText"></span>
            </div>

            <!-- Confirm New Password -->
            <div class="form-group">
                <input type="password" id="confirmPassword" name="npassword" class="form-input" placeholder="Confirm New Password" required />
                <span class="inputerror" id="confirmPasswordError">Confirm new password is required *</span>
                <span class="inputerror" id="passwordMatchError" style="display: none;">Passwords do not match *</span>
            </div>

            <!-- Submit Button -->
            <div class="form-group">
                <button type="submit" class="loginbutton" id="setNewPasswordBtn" disabled>Set New Password</button>
            </div>
        }
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const passwordInput = document.getElementById('password');
        const confirmPasswordInput = document.getElementById('confirmPassword');
        const passwordError = document.getElementById('passwordError');
        const confirmPasswordError = document.getElementById('confirmPasswordError');
        const passwordMatchError = document.getElementById('passwordMatchError');
        const strengthBar = document.getElementById('strengthBar');
        const strengthText = document.getElementById('strengthText');
        const setNewPasswordBtn = document.getElementById('setNewPasswordBtn');

        if (setNewPasswordBtn) {
            setNewPasswordBtn.disabled = true;
        }


        if (passwordInput && confirmPasswordInput && passwordError && confirmPasswordError && passwordMatchError && strengthBar && strengthText && setNewPasswordBtn) {
            passwordInput.addEventListener('keyup', checkPasswordStrength);
            passwordInput.addEventListener('change', validateInputs);
            confirmPasswordInput.addEventListener('keyup', validateInputs);
            confirmPasswordInput.addEventListener('change', validateInputs);

            validateInputs();
        } else {
            console.error("One or more required elements for password strength/validation not found. Script functionality may be limited.");
        }


        function checkPasswordStrength() {
            const password = passwordInput.value;
            let score = 0;
            let feedback = '';
            let barWidth = '0%';
            let barClass = '';

            // Criteria checks
            const hasLower = /[a-z]/.test(password);
            const hasUpper = /[A-Z]/.test(password);
            const hasNumber = /[0-9]/.test(password);
            const hasSpecial = /[!#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password);

            // Score based on criteria
            if (password.length >= 8) score += 1;
            if (password.length >= 10) score += 1;
            if (password.length >= 16) score += 1;
            if (hasLower) score += 1;
            if (hasUpper) score += 1;
            if (hasNumber) score += 1;
            if (hasSpecial) score += 1;

            // Determine strength feedback
            if (password.length === 0) {
                feedback = '';
                barWidth = '0%';
                barClass = '';
            } else if (score < 3) {
                feedback = 'Too Weak';
                barWidth = '25%';
                barClass = 'weak';
            } else if (score < 6) {
                feedback = 'Weak';
                barWidth = '50%';
                barClass = 'moderate';
            } else if (score < 7) {
                feedback = 'Strong';
                barWidth = '75%';
                barClass = 'strong';
            } else {
                feedback = 'Very Strong';
                barWidth = '100%';
                barClass = 'very-strong';
            }

            // Update UI
            strengthText.textContent = feedback;
            strengthText.className = 'strength-text ' + barClass;
            strengthBar.style.width = barWidth;
            strengthBar.className = 'strength-bar ' + barClass;

            validateInputs();
        }

        function validateInputs() {
            const password = passwordInput.value;
            const confirmPassword = confirmPasswordInput.value;
            let isValid = true;

            // Password field validation
            if (!password) {
                passwordError.style.display = 'block';
                isValid = false;
            } else {
                passwordError.style.display = 'none';
            }
            // Confirm Password field validation
            if (!confirmPassword) {
                confirmPasswordError.style.display = 'block';
                passwordMatchError.style.display = 'none';
                isValid = false;
            } else {
                confirmPasswordError.style.display = 'none';
            }
            // Password match validation
            if (password && confirmPassword && password !== confirmPassword) {
                passwordMatchError.style.display = 'block';
                isValid = false;
            } else {
                passwordMatchError.style.display = 'none';
            }

            const currentStrength = strengthText.textContent;
            const meetsMinStrength = (currentStrength === 'Strong' || currentStrength === 'Very Strong');

            if (setNewPasswordBtn) {
                if (isValid && password.length > 0 && meetsMinStrength) {
                    setNewPasswordBtn.disabled = false;
                } else {
                    setNewPasswordBtn.disabled = true;
                }
            }
        }
    });
</script>
