@model Afidep_E_Recruitment.Controllers.JobController.Attachment
@* Note: You might want to create a new model for document attachments if its properties differ significantly from JobReferee. For simplicity, I'm keeping the existing model for now, but be aware of the implications. *@

<div class="modal-header">
    <h5 class="modal-title" id="documentUploadModalLabel">Attach Document</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

@using (Html.BeginForm("AddDocumentAttachment", "Job", FormMethod.Post, new { @id = "addDocumentForm", @class = "modal-body", @enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <input type="hidden" name="applicationNumber" value="@ViewBag.ApplicationNumber" />

    <div class="row">
        <div class="col-md-3 mb-3">
            @Html.Label("DocumentDescription", "Description", new { @class = "form-label" })
            @Html.TextArea("DocumentDescription", new { @class = "form-control", @placeholder = "e.g., My academic transcript", @rows = "3", @required = "required" })
            @Html.ValidationMessage("DocumentDescription", "", new { @class = "text-danger" })
        </div>
        <div class="col-md-3 mb-1">
            @Html.Label("DocumentType", "Select Document Type", new { @class = "form-label" })
            @Html.DropDownList("DocumentType", ViewBag.DocumentTypes as SelectList, "Select Document Type", new { @class = "form-select", @required = "required" })
            @Html.ValidationMessage("DocumentType", "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6 mb-3">
            @Html.Label("DocumentFile", "Select File", new { @class = "form-label" })
            <input type="file" id="DocumentFile" name="DocumentFile" class="form-control" required="required" />
            <span class="text-danger" data-valmsg-for="DocumentFile" data-valmsg-replace="true"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Upload Document</button>
    </div>
}

<script>
    $.validator.unobtrusive.parse("#addDocumentForm");

    $('#addDocumentForm').on('submit', function (e) {
        e.preventDefault();

        var form = $(this);
        if (form.valid()) {
            var formData = new FormData(form[0]);

            $.ajax({
                url: form.attr('action'),
                type: form.attr('method'),
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                        window.location.reload();
                    } else {
                        alert("Your changes could not be saved at the moment");
                        window.location.reload();
                    }
                },
                error: function (xhr, status, error) {
                    alert("Your changes could not be saved at the moment");
                    window.location.reload();
                }
            });
        }
    });
</script>