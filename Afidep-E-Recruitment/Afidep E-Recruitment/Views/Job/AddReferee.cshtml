@model Afidep_E_Recruitment.Controllers.JobController.JobReferee

<div class="modal-header">
    <h5 class="modal-title" id="academicModalLabel">Add Referee</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

@using (Html.BeginForm("AddReferee", "Job", FormMethod.Post, new { @id = "addRefereeForm", @class = "modal-body" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <input type="hidden" name="applicationNumber" id="applicationNumber" value="@ViewBag.ApplicationNumber" />

    <div class="row">
        <div class="col-md-4 mb-1">
            @Html.LabelFor(m => m.names, "Names", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.names, new { @class = "form-control", @placeholder = "e.g., Jane Doe", @required = "required" })
            @Html.ValidationMessageFor(m => m.names, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4 mb-1">
            @Html.LabelFor(m => m.company, "Company", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.company, new { @class = "form-control", @placeholder = "e.g., AFIDEP", @required = "required" })
            @Html.ValidationMessageFor(m => m.company, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4 mb-1">
            @Html.LabelFor(m => m.designation, "Designation", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.designation, new { @class = "form-control", @placeholder = "e.g., Manager", @required = "required" })
            @Html.ValidationMessageFor(m => m.designation, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-1">
            @Html.LabelFor(m => m.address, "Address", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.address, new { @class = "form-control", @placeholder = "e.g., P.O.Box 1234 Nairobi, Kenya" })
            @Html.ValidationMessageFor(m => m.address, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4 mb-1">
            @Html.LabelFor(m => m.telephone, "Telephone Number", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.telephone, new { @class = "form-control", @placeholder = "e.g., +254700000000", @required = "required" })
            @Html.ValidationMessageFor(m => m.telephone, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4 mb-1">
            @Html.LabelFor(m => m.email, "Email", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.email, new { @class = "form-control", @placeholder = "e.g., janedoe@gmail.com", @required = "required" })
            @Html.ValidationMessageFor(m => m.email, "", new { @class = "text-danger" })
        </div>
    </div>

    <div id="refereeLoadingSpinner" class="text-center my-3" style="display:none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Processing...</span>
        </div>
        <p class="mt-2">Saving Referee...</p>
    </div>

    <div id="refereeSaveError" class="alert alert-danger mt-2" style="display:none;"></div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="AddRefereeButton">Save Referee</button>
    </div>
}

<script>
    $.validator.unobtrusive.parse("#addRefereeForm");

    $('#AddRefereeButton').off('click').on('click', function () {
        if (!$('#addRefereeForm').valid()) return;

        $('#refereeLoadingSpinner').show();
        $('#refereeSaveError').hide();
        $('#AddRefereeButton').prop('disabled', true).text('Saving...');

        const payload = {
            applicationnumber: $('#applicationNumber').val(),
            modify_type: "referee_details",
            application_details: {
                referees: [{
                    names: $('#names').val(),
                    company: $('#company').val(),
                    designation: $('#designation').val(),
                    address: $('#address').val(),
                    telephone: $('#telephone').val(),
                    email: $('#email').val()
                }]
            }
        };

        $.ajax({
            type: "POST",
            url: "/Job/EditJobApp",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify(payload),
            success: function (response) {
                $('#refereeLoadingSpinner').hide();
                if (response.status) {
                    // Close modal and refresh the referees list — no page reload
                    bootstrap.Modal.getInstance(
                        document.getElementById('academicQualificationModal')
                    ).hide();
                    loadReferees(); // defined in the parent view
                } else {
                    $('#AddRefereeButton').prop('disabled', false).text('Save Referee');
                    $('#refereeSaveError').text('Failed to save referee. Please try again.').show();
                }
            },
            error: function () {
                $('#refereeLoadingSpinner').hide();
                $('#AddRefereeButton').prop('disabled', false).text('Save Referee');
                $('#refereeSaveError').text('An error occurred. Please try again.').show();
            }
        });
    });
</script>