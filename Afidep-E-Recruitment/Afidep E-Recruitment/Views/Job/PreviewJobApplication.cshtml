                                    </div>
                                }
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <button type="button" class="btn btn-secondary prev-tab"><i class="bi bi-arrow-left me-2"></i> Previous</button>
                                <button type="button" class="btn btn-primary next-tab">Next <i class="bi bi-arrow-right"></i></button>
                            </div>
                        </div>
                    </div>

                    @* Tab 8: Profile Preview *@
                    <div class="tab-pane fade" id="preview" role="tabpanel" aria-labelledby="preview-tab">
                        <div class="card p-4 shadow-sm">
                            <h5 class="card-title mb-4">Application Preview</h5>

                            <div id="PreviewContainer" style="width: 100%; height: 500px; border: 1px solid #dee2e6; border-radius: .25rem;">
                                <iframe id="pdfViewer" style="width: 100%; height: 100%; border: none; display: none;"></iframe>
                                <div id="pdfPlaceholder" class="text-center" style="padding-top: 50px;">
                                    <p class="text-muted">Loading Application Preview...</p>
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <button type="button" class="btn btn-secondary prev-tab"><i class="bi bi-arrow-left me-2"></i> Previous</button>
                                @* No 'Next' button here as it's the last tab *@
                            </div>
                        </div>
                    </div>


                </div>
            }
        </div>
    </div>
</main>

<div class="modal fade" id="academicQualificationModal" tabindex="-1" aria-labelledby="academicModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="academicQualificationModalContent">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading form...</p>
            </div>
        </div>
    </div>
</div>

@* --- End Bootstrap Modal --- *@
@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script>
        $(document).ready(function () {

            // ── Tab Navigation ──────────────────────────────────────────
            $('.next-tab').on('click', function () {
                var currentTabPane = $(this).closest('.tab-pane');
                var currentTabId = '#' + currentTabPane.attr('id');
                var currentTabIndex = $('#applicationTabs button')
                    .index($('button[data-bs-target="' + currentTabId + '"]'));
                var nextTabButton = $('#applicationTabs button').eq(currentTabIndex + 1);
                if (nextTabButton.length) {
                    new bootstrap.Tab(nextTabButton[0]).show();
                }
            });

            $('.prev-tab').on('click', function () {
                var currentTabPane = $(this).closest('.tab-pane');
                var currentTabId = '#' + currentTabPane.attr('id');
                var currentTabIndex = $('#applicationTabs button')
                    .index($('button[data-bs-target="' + currentTabId + '"]'));
                var prevTabButton = $('#applicationTabs button').eq(currentTabIndex - 1);
                if (prevTabButton.length) {
                    new bootstrap.Tab(prevTabButton[0]).show();
                }
            });

            // ── PDF Preview (single handler, no conflicts) ───────────────
            var pdfLoaded = false;
            var applicationNumber = '@Model.applicationnumber';

            $('#preview-tab').on('shown.bs.tab', function () {
                if (pdfLoaded) return; // already loaded, don't reload

                $('#pdfPlaceholder').show();
                $('#pdfViewer').hide();

                if (!applicationNumber) {
                    $('#pdfPlaceholder').html(
                        '<p class="text-warning">Application number not found.</p>'
                    );
                    return;
                }

                $.ajax({
                    url: '@Url.Action("GetApplicationPdfBase64", "Job")',
                    type: 'GET',
                    data: { applicationNumber: applicationNumber },
                    success: function (base64String) {
                        if (base64String && base64String.length > 0) {

                            // ✅ Use a blob URL instead of data: URI — works in all browsers
                            var byteChars = atob(base64String);
                            var byteNumbers = new Array(byteChars.length);
                            for (var i = 0; i < byteChars.length; i++) {
                                byteNumbers[i] = byteChars.charCodeAt(i);
                            }
                            var byteArray = new Uint8Array(byteNumbers);
                            var blob = new Blob([byteArray], { type: 'application/pdf' });
                            var blobUrl = URL.createObjectURL(blob);

                            $('#pdfViewer').attr('src', blobUrl);
                            $('#pdfPlaceholder').hide();
                            $('#pdfViewer').show();
                            pdfLoaded = true;

                        } else {
                            $('#pdfPlaceholder').html(
                                '<p class="text-info">No PDF preview available for this application yet.</p>'
                            );
                        }
                    },
                    error: function (xhr) {
                        var msg = xhr.status === 204
                            ? 'PDF not yet generated for this application.'
                            : 'Error loading preview. Please try again later.';
                        $('#pdfPlaceholder').html(
                            '<p class="text-danger">' + msg + '</p>'
                        );
                        $('#pdfViewer').hide();
                    }
                });
            });

