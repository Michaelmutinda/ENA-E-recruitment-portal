@model Afidep_E_Recruitment.Controllers.HomeController.ProfessionalMembership


<div class="modal-header">
    <h5 class="modal-title" id="academicModalLabel">Add Professional Membership</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
@using (Html.BeginForm("AddAcademicQualification", "OnlineApplications", FormMethod.Post, new { @id = "addAcademicQualForm", @class = "modal-body" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <input type="hidden" name="applicationNumber" value="@ViewBag.ApplicationNumber" />
    <div class="row">
        <div class="col-md-4 mb-1">
            @Html.LabelFor(m => m.profbody, "Professional Body", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.profbody, new { @class = "form-control", @placeholder = "e.g., Certified Public Accountants of Kenya", @required = "required" })
            @Html.ValidationMessageFor(m => m.profbody, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4 mb-1">
            @Html.LabelFor(m => m.memberno, "Membership Number", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.memberno, new { @class = "form-control", @placeholder = "e.g., CPA24132", @required = "required" })
            @Html.ValidationMessageFor(m => m.memberno, "", new { @class = "text-danger" })
        </div>
    </div>

    <div id="academicLoadingSpinner" class="text-center my-3" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Processing...</span>
        </div>
        <p class="mt-2">Saving Professional Membership...</p>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="AddProfessionalMembershipButton">Save Professional Membership</button>
    </div>
}

<script>
    // Re-parse unobtrusive validation for the dynamically loaded form
    $.validator.unobtrusive.parse("#addAcademicQualForm");

    // Handle the AJAX form submission for the modal form
    function RelocatePage(applicationNumber) {
        setTimeout(() => {
            window.location.href = `/Job/ApplyJob?applicationnumber=${applicationNumber}`;
        }, 1000);
    }

    // Handle the AJAX form submission for the modal form
    $('#AddProfessionalMembershipButton').on('click', function () {
        if (!$('#addAcademicQualForm').valid()) return;

        $('#academicLoadingSpinner').show();
        $('#AddProfessionalMembershipButton').prop('disabled', true).text('Saving...');

        const updateinputjson = {
            applicationnumber: $('#applicationnumber').val(),
            modify_type: "prof_memb_details",
            application_details: {},
        };

        const profmembership = [{
            profbody: $('#profbody').val(),
            memberno: $('#memberno').val(),
        }];


        updateinputjson.application_details = {
            profmembership: profmembership,
        };

        $.ajax({
            type: "POST",
            url: "/Job/EditJobApp",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify(updateinputjson),
            success: function (response) {
                RelocatePage(updateinputjson.applicationnumber);
            },
            error: function () {
                RelocatePage(updateinputjson.applicationnumber);
            }
        });
    });
</script>