@model Afidep_E_Recruitment.Controllers.HomeController.ProfessionalQualification


<div class="modal-header">
    <h5 class="modal-title" id="academicModalLabel">Add Professional Course</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
@using (Html.BeginForm("AddAcademicQualification", "OnlineApplications", FormMethod.Post, new { @id = "addAcademicQualForm", @class = "modal-body" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <input type="hidden" name="applicationNumber" value="@ViewBag.ApplicationNumber" />
    <div class="row">
        <div class="col-md-4 mb-1">
            @Html.LabelFor(m => m.description, "Qualification", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.description, new { @class = "form-control", @placeholder = "e.g., Certified Public Accountant", @required = "required" })
            @Html.ValidationMessageFor(m => m.description, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4 mb-1">
            @Html.LabelFor(m => m.level, "Section/Level", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.level, new { @class = "form-control", @placeholder = "e.g., 1", @required = "required", @type = "number", @min = "1" })
            @Html.ValidationMessageFor(m => m.level, "", new { @class = "text-danger" })
        </div>
    </div>

    <div id="academicLoadingSpinner" class="text-center my-3" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Processing...</span>
        </div>
        <p class="mt-2">Saving Professional Course...</p>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="AddProfessionalCourseButton">Save Professional Course</button>
    </div>
}

<script>
    // Re-parse unobtrusive validation for the dynamically loaded form
    $.validator.unobtrusive.parse("#addAcademicQualForm");

    function RelocatePage(applicationNumber) {
        setTimeout(() => {
            window.location.href = `/Job/ApplyJob?applicationnumber=${applicationNumber}`;
        }, 1000);
    }

    // Handle the AJAX form submission for the modal form
    $('#AddProfessionalCourseButton').on('click', function () {
        if (!$('#addAcademicQualForm').valid()) return;

        $('#academicLoadingSpinner').show();
        $('#AddProfessionalCourseButton').prop('disabled', true).text('Saving...');

        const updateinputjson = {
            applicationnumber: $('#applicationnumber').val(),
            modify_type: "prof_course_details",
            application_details: {},
        };

        const profqualifications = [{
            description: $('#description').val(),
            level: $('#level').val(),
        }];


        updateinputjson.application_details = {
            profqualifications: profqualifications,
        };

        $.ajax({
            type: "POST",
            url: "/Job/EditJobApp",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify(updateinputjson),
            success: function (response) {
                RelocatePage(updateinputjson.applicationnumber);
            },
            error: function () {
                RelocatePage(updateinputjson.applicationnumber);
            }
        });
    });
</script>