@model Afidep_E_Recruitment.Models.LRClasses.RegistrationUserClass

@{
    ViewBag.Title = "Set New Password";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<style>
    .auth-header h2 {
        font-size: 1.3rem;
        margin-bottom: 20px;
        color: #6A1B9A;
        font-weight: 600;
        text-align: center;
    }

    .form-group {
        margin-bottom: 14px;
    }

    .form-input {
        width: 100%;
        padding: 10px;
        border: 1px solid #6A1B9A;
        border-radius: 6px;
        font-size: 0.95rem;
    }

    .loginbutton {
        background-color: #6A1B9A;
        color: #fff;
        border: none;
        padding: 12px;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 6px;
        width: 100%;
        cursor: pointer;
    }

        .loginbutton:disabled {
            background-color: #ccc;
            cursor: not-allowed;
        }

    .inputerror {
        color: #d32f2f;
        font-size: 0.8rem;
        display: none;
    }

    .password-strength-indicator {
        height: 6px;
        background: #eee;
        border-radius: 4px;
        margin-top: 6px;
        overflow: hidden;
    }

    .strength-bar {
        height: 100%;
        width: 0%;
        transition: width 0.3s ease;
    }

        .strength-bar.weak {
            background: #d32f2f;
        }

        .strength-bar.moderate {
            background: #fbc02d;
        }

        .strength-bar.strong {
            background: #388e3c;
        }

        .strength-bar.very-strong {
            background: #2e7d32;
        }
</style>

<div class="auth-header">
    <h2>Set Your New Password</h2>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@using (Html.BeginForm("SetNewPasswordForm", "Register", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <input type="hidden"
           name="username"
           value="@Model.id_number" />


    <div class="form-group">
        <input type="text" class="form-input" value="@Model.id_number" readonly />
    </div>

    <div class="form-group">
        <input type="password" id="password" name="password"
               class="form-input" placeholder="New Password" required />
        <span class="inputerror" id="passwordError">Password is required *</span>

        <div class="password-strength-indicator">
            <div class="strength-bar" id="strengthBar"></div>
        </div>
        <span id="strengthText"></span>
    </div>

    <div class="form-group">
        <input type="password" id="confirmPassword" name="npassword"
               class="form-input" placeholder="Confirm New Password" required />
        <span class="inputerror" id="confirmPasswordError">Confirm password is required *</span>
        <span class="inputerror" id="passwordMatchError">Passwords do not match *</span>
    </div>

    <button type="submit" class="loginbutton" id="setNewPasswordBtn" disabled>
        Set New Password
    </button>
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const passwordInput = document.getElementById('password');
        const confirmPasswordInput = document.getElementById('confirmPassword');
        const passwordError = document.getElementById('passwordError');
        const confirmPasswordError = document.getElementById('confirmPasswordError');
        const passwordMatchError = document.getElementById('passwordMatchError');
        const strengthBar = document.getElementById('strengthBar');
        const strengthText = document.getElementById('strengthText');
        const btn = document.getElementById('setNewPasswordBtn');

        btn.disabled = true;

        passwordInput.addEventListener('keyup', checkStrength);
        confirmPasswordInput.addEventListener('keyup', validate);

        function checkStrength() {
            const p = passwordInput.value;
            let score = 0;
            if (p.length >= 8) score++;
            if (/[a-z]/.test(p)) score++;
            if (/[A-Z]/.test(p)) score++;
            if (/[0-9]/.test(p)) score++;
            if (/[^A-Za-z0-9]/.test(p)) score++;

            let width = '0%', cls = '';
            if (score <= 2) { width = '25%'; cls = 'weak'; }
            else if (score === 3) { width = '50%'; cls = 'moderate'; }
            else if (score === 4) { width = '75%'; cls = 'strong'; }
            else { width = '100%'; cls = 'very-strong'; }

            strengthBar.style.width = width;
            strengthBar.className = 'strength-bar ' + cls;
            validate();
        }

        function validate() {
            const p = passwordInput.value;
            const c = confirmPasswordInput.value;

            passwordError.style.display = p ? 'none' : 'block';
            confirmPasswordError.style.display = c ? 'none' : 'block';
            passwordMatchError.style.display = (p && c && p !== c) ? 'block' : 'none';

            btn.disabled = !(p && c && p === c && strengthBar.style.width !== '25%');
        }
    });
</script>
